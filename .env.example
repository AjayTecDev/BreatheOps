# LOCAL development only. Never commit .env. NOTE: the server reads real environment variables, it does not auto-load this file. In CMD use: set NAME=value (one per line) before starting the server. Never put AWS secret keys here:
# on AWS the Lambda role provides credentials; locally use `aws configure` / SSO profiles.
APP_ENV=local                # local | production (production enforces token auth, https origin, TABLE)
ENVIRONMENT_PROVIDER=replay  # replay needs no credentials | live needs the two ENVIRONMENT_* values
ENVIRONMENT_API_URL=
ENVIRONMENT_API_KEY=         # on AWS prefer SSM Parameter Store SecureString / Secrets Manager
AWS_REGION=
TABLE=                       # empty = in-memory repository
BEDROCK_MODEL_ID=            # empty = AI off, deterministic planner only
AUTH_MODE=demo               # demo (local only) | token
ADMIN_TOKEN=                 # min 16 chars when AUTH_MODE=token
ALLOWED_ORIGIN=*             # set to your https frontend origin for production
